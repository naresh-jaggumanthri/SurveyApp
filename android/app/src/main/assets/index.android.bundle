__d((function(e,a,i,t,r,o,n){r.exports={translation:{Mobile_Number:"Ingrese su n\xfamero de m\xf3vil",Login_Text:"Iniciar sesi\xf3n",Password_Text:"Contrase\xf1a",Dont_Have_Account:"\xbfNo tienes una cuenta?",Register_Text:"Registrarse",Enter_Your_Name:"Ingrese su nombre",Mobile_number:"N\xfamero de m\xf3vil",Login_Successfull:"Inicio de sesi\xf3n exitoso",Enter_Your_Email:"Ingrese su correo electr\xf3nico",I_Agree_Text:"Estoy de acuerdo con los",Terms_Of_Service:"T\xe9rminos de servicio",And_text:"y",Privacy_Policy:"Pol\xedtica de privacidad.",Already_Member:"\xbfYa eres miembro?",Select_Language:"Seleccione su idioma",Confirm_Text:"Confirmar",We_Well_Sand_Message:"Le enviaremos un mensaje para configurar o restablecer su nueva contrase\xf1a",Read_More_Text:"Leer m\xe1s",Show_Less_Text:"Mostrar menos",New_Text:"Nuevo",Resand_Otp_Text_Modal:"Reenviar OTP enviado por SMS o a su direcci\xf3n de correo electr\xf3nico",Get_Started:"Comenzar",Sign_Up_Text:"Reg\xedstrate",OTP_Title_1:"Verificaci\xf3n de OTP",OTP_Title_2:"Se ha enviado un c\xf3digo de 4 d\xedgitos",OTP_Title_3:"a",OTP_Title_4:"N\xfamero de m\xf3vil",Didnt_Recevip_Otp:"\xa1No recibi\xf3 el c\xf3digo OTP!",Resend:"Reenviar",Forgot_Password:"\xbfOlvid\xf3 su contrase\xf1a?",Ok:"Ok",Cancel_Button:"Cancelar",Are_You_Sure:"\xbfEst\xe1 seguro de que desea cerrar sesi\xf3n?",Log_Out:"Cerrar sesi\xf3n",Next_Text:"Siguiente",Skip_Text:"Omitir",Profile_Text:"Perfil",Swiperfirst:"Conect\xe1ndote con astr\xf3logos y ps\xedquicos expertos para obtener informaci\xf3n c\xf3smica personalizada y orientaci\xf3n espiritual",Swipertitle:"Navegando tus conocimientos, fortaleciendo tu voz",SwiperFirstTwo:"Explora el cosmos y busca sabidur\xeda celestial con Astrotalk: tu aplicaci\xf3n de consulta astrol\xf3gica y ps\xedquica todo en uno",SwiperTitleTwo:"Donde residen tus opiniones, donde comienzan las innovaciones",SwiperFirstThree:"Donde las estrellas se alinean con los mejores astr\xf3logos y asesores ps\xedquicos para iluminar el camino de tu vida",Swipertitlethree:"Creando soluciones a trav\xe9s de tus valiosas perspectivas",Verify_Text:"Verificar",Are_You_Sure_logout:"\xbfEst\xe1s seguro de que quieres cerrar sesi\xf3n?",Setting_Text:"Configuraci\xf3n",Graham_Gooch:"Graham Gooch",ChatText_Let_Me:"Hola, estoy buscando informaci\xf3n sobre mi carrera. \xbfPuedes ayudarme con eso?",Chattext_Actually_I_Have:"Por supuesto, estar\xe9 encantado de ayudarte. \xbfPodr\xedas proporcionarme tu fecha y hora de nacimiento?",Chat_Can_You_Just:"Soy Sagitario y tengo problemas de relaci\xf3n. \xbfQu\xe9 puedes decirme?",Chat_Multipal_Project:"Gracias por compartir tu signo zodiacal. \xbfPodr\xedas proporcionar tambi\xe9n el signo de tu pareja?",Chat_Excellent:"Tengo una gran decisi\xf3n que tomar. \xbfPodr\xedas hacerme una lectura de cartas del tarot?",Chat_Last_Paregraph:"\xa1Absolutamente! Comencemos con tu pregunta.",Write_A_Reply:"Escribe una respuesta...",Type_Your_Message:"Escribe tu mensaje",Help_sand_mail:"Enviar correo",Help_sand_mail_Successful:"Env\xedo de correo electr\xf3nico exitoso",Help_paregraph:"Lorem Ipsum ha sido el texto de relleno est\xe1ndar de la industria desde el a\xf1o 1500, cuando un impresor desconocido tom\xf3 una galer\xeda de tipos y los mezcl\xf3 para hacer un libro de muestras de tipos.",FAQ_paregraph_One:"Nuestra aplicaci\xf3n de encuestas permite a los usuarios crear, distribuir y analizar encuestas con diversos prop\xf3sitos como investigaci\xf3n de mercado, retroalimentaci\xf3n de clientes, satisfacci\xf3n de empleados, etc.",FAQ_paregraph_Two:"\xbfCu\xe1l es el prop\xf3sito de esta aplicaci\xf3n de encuestas?",FAQ_paregraph_Three:"Para crear una nueva encuesta, simplemente inicie sesi\xf3n en su cuenta, haga clic en el bot\xf3n 'Crear encuesta' y siga las instrucciones paso a paso para agregar preguntas, personalizar configuraciones y dise\xf1ar la encuesta.",FAQ_paregraph_Four:"\xbfC\xf3mo puedo crear una nueva encuesta?",FAQ_paregraph_Five:"S\xed, puede personalizar la apariencia de sus encuestas eligiendo entre diferentes temas, colores, fuentes y agregando su logotipo o elementos de marca.",FAQ_paregraph_Six:"\xbfPuedo personalizar la apariencia de mis encuestas?",FAQ_Paregraph_Saven:"No, no hay l\xedmite en el n\xfamero de preguntas que puede incluir en una encuesta. Puede agregar tantas preguntas como necesite para recopilar la informaci\xf3n requerida.",FAQ_Paregraph_Aeight:"\xbfHay un l\xedmite en el n\xfamero de preguntas que puedo incluir en una encuesta?",FAQ_Paregraph_Nine:"S\xed, puede mejorar sus preguntas de encuesta agregando im\xe1genes, videos o archivos de audio para hacerlas m\xe1s atractivas e interactivas.",FAQ_Paregraph_Ten:"\xbfPuedo agregar im\xe1genes o multimedia a mis preguntas de encuesta?",FAQ_Paregraph_Eleven:"Actualmente est\xe1 disponible en ingl\xe9s, franc\xe9s, \xe1rabe y espa\xf1ol.",FAQ_One:"\xbfLa aplicaci\xf3n est\xe1 disponible en otros idiomas?",FAQ_Two:"Si no est\xe1 satisfecho con su consulta, comun\xedquese con nuestro equipo de soporte. Podemos ofrecer un reembolso o proporcionarle una consulta alternativa.",FAQ_Three:"\xbfQu\xe9 sucede si no estoy satisfecho con mi consulta?",FAQ_Four:"Puede comunicarse con nuestro equipo de soporte al cliente a trav\xe9s de la secci\xf3n 'Cont\xe1ctenos' de la aplicaci\xf3n, donde puede enviarnos un mensaje o solicitar asistencia con cualquier problema o inquietud.",FAQ_Five:"\xbfC\xf3mo puedo contactar al soporte al cliente?",Reviews_Submit_Successful:"Env\xedo exitoso",Please_OnDemand_Service:"\xa1Por favor, califica la aplicaci\xf3n de encuestas!",Please_OnDemand_Two:"Tus comentarios y sugerencias nos ayudan a mejorar la aplicaci\xf3n de encuestas.",Reviews_Enter_Your_Commenet:"Ingrese su comentario",Reviews_Submit:"Enviar",Email_Successfull:"El correo electr\xf3nico se ha enviado exitosamente",Setting_Title_1:"Bluetooth",Setting_Title_2:"Toque Conexi\xf3n de dispositivos conectados Preferencias de conexi\xf3n.",Setting_Title_3:"Notifica