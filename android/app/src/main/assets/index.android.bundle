__d((function(e,i,t,o,r,a,n){r.exports={translation:{Mobile_Number:"Entrez votre num\xe9ro de portable",Login_Text:"Connexion",Password_Text:"Mot de passe",Dont_Have_Account:"Vous n'avez pas de compte?",Register_Text:"S'inscrire",Enter_Your_Name:"Entrez votre nom",Mobile_number:"Num\xe9ro de portable",Login_Successfull:"Connexion r\xe9ussie",Enter_Your_Email:"Entrez votre adresse e-mail",I_Agree_Text:"Je suis d'accord avec les",Terms_Of_Service:"Conditions de service",And_text:"et",Privacy_Policy:"Politique de confidentialit\xe9.",Already_Member:"D\xe9j\xe0 membre?",Select_Language:"S\xe9lectionnez votre langue",Confirm_Text:"Confirmer",We_Well_Sand_Message:"Nous vous enverrons un message pour d\xe9finir ou r\xe9initialiser votre nouveau mot de passe",Read_More_Text:"Lire la suite",Show_Less_Text:"Afficher moins",New_Text:"Nouveau",Resand_Otp_Text_Modal:"Renvoyer le code OTP par SMS ou \xe0 votre adresse e-mail",Get_Started:"Commencer",Sign_Up_Text:"S'inscrire",OTP_Title_1:"V\xe9rification par OTP",OTP_Title_2:"Un code \xe0 4 chiffres a \xe9t\xe9 envoy\xe9",OTP_Title_3:"\xe0",OTP_Title_4:"Num\xe9ro de portable",Didnt_Recevip_Otp:"Vous n'avez pas re\xe7u de code OTP!",Resend:"Renvoyer",Forgot_Password:"Mot de passe oubli\xe9?",Ok:"Ok",Cancel_Button:"Annuler",Are_You_Sure:"\xcates-vous s\xfbr de vouloir vous d\xe9connecter?",Log_Out:"D\xe9connexion",Next_Text:"Suivant",Skip_Text:"Passer",Profile_Text:"Profil",Swiperfirst:"Vous mettant en relation avec des astrologues et des m\xe9diums experts pour des visions cosmiques personnalis\xe9es et des conseils spirituels",Swipertitle:"Naviguer dans vos id\xe9es, renforcer votre voix",SwiperFirstTwo:"Explorez le cosmos et recherchez la sagesse c\xe9leste avec Astrotalk : Votre application de consultation astrologique et psychique tout-en-un",SwiperTitleTwo:"O\xf9 r\xe9sident vos opinions, o\xf9 commencent les innovations",SwiperFirstThree:"O\xf9 les \xe9toiles s'alignent avec les meilleurs astrologues et conseillers psychiques pour illuminer le chemin de votre vie",Swipertitlethree:"Cr\xe9er des solutions \xe0 travers vos perspectives pr\xe9cieuses",Verify_Text:"V\xe9rifier",Are_You_Sure_logout:"\xcates-vous s\xfbr de vouloir vous d\xe9connecter?",Setting_Text:"R\xe9glage",Graham_Gooch:"Graham Gooch",ChatText_Let_Me:"Bonjour, je cherche des informations sur ma carri\xe8re. Pouvez-vous m'aider avec \xe7a?",Chattext_Actually_I_Have:"Bien s\xfbr, je serais ravi de vous aider. Pourriez-vous me donner votre date et heure de naissance?",Chat_Can_You_Just:"Je suis Sagittaire et j'ai des probl\xe8mes relationnels. Que pouvez-vous me dire?",Chat_Multipal_Project:"Merci d'avoir partag\xe9 votre signe du zodiaque. Pourriez-vous fournir le signe de votre partenaire \xe9galement?",Chat_Excellent:"J'ai une grande d\xe9cision \xe0 prendre. Pouvez-vous me faire une lecture de tarot?",Chat_Last_Paregraph:"Absolument! Commen\xe7ons par votre question.",Write_A_Reply:"\xc9crire une r\xe9ponse...",Type_Your_Message:"Tapez votre message",Help_sand_mail:"Envoyer un e-mail",Help_sand_mail_Successful:"Envoi de l'email r\xe9ussi",Help_paregraph:"Lorem Ipsum est depuis longtemps le texte standard de l'industrie, il date de 1500.",FAQ_paregraph_One:"Notre application de sondage permet aux utilisateurs de cr\xe9er, distribuer et analyser des sondages \xe0 des fins diverses telles que la recherche de march\xe9, les retours clients, la satisfaction des employ\xe9s, etc.",FAQ_paregraph_Two:"Quel est l'objectif de cette application de sondage?",FAQ_paregraph_Three:"Pour cr\xe9er un nouveau sondage, connectez-vous simplement \xe0 votre compte, cliquez sur le bouton 'Cr\xe9er un sondage' et suivez les instructions \xe9tape par \xe9tape pour ajouter des questions, personnaliser les param\xe8tres et concevoir le sondage.",FAQ_paregraph_Four:"Comment cr\xe9er un nouveau sondage?",FAQ_paregraph_Five:"Oui, vous pouvez personnaliser l'apparence de vos sondages en choisissant parmi diff\xe9rents th\xe8mes, couleurs, polices, et en ajoutant votre logo ou des \xe9l\xe9ments de branding.",FAQ_paregraph_Six:"Puis-je personnaliser l'apparence de mes sondages?",FAQ_Paregraph_Saven:"Non, il n'y a pas de limite au nombre de questions que vous pouvez inclure dans un sondage. Vous pouvez ajouter autant de questions que n\xe9cessaire pour recueillir les informations requises.",FAQ_Paregraph_Aeight:"Y a-t-il une limite au nombre de questions que je peux inclure dans un sondage?",FAQ_Paregraph_Nine:"Oui, vous pouvez am\xe9liorer vos questions de sondage en ajoutant des images, des vid\xe9os ou des fichiers audio pour les rendre plus attrayantes et interactives.",FAQ_Paregraph_Ten:"Puis-je ajouter des images ou du multim\xe9dia \xe0 mes questions de sondage?",FAQ_Paregraph_Eleven:"Actuellement, il est disponible en anglais, fran\xe7ais, arabe et espagnol.",FAQ_One:"L'application est-elle disponible dans d'autres langues?",FAQ_Two:"Si vous n'\xeates pas satisfait de votre consultation, veuillez contacter notre \xe9quipe de support. Nous pouvons proposer un remboursement ou vous fournir une consultation alternative.",FAQ_Three:"Que se passe-t-il si je ne suis pas satisfait de ma consultation?",FAQ_Four:"Vous pouvez contacter notre \xe9quipe de support client via la section 'Contactez-nous' de l'application, o\xf9 vous pouvez nous envoyer un message ou demander de l'aide pour tout probl\xe8me ou pr\xe9occupation.",FAQ_Five:"Comment puis-je contacter le support client?",Reviews_Submit_Successful:"Soumission r\xe9ussie",Please_OnDemand_Service:"Veuillez noter l'application de sondage !",Please_OnDemand_Two:"Vos commentaires et suggestions nous aident \xe0 am\xe9liorer l'application de sondage.",Reviews_Enter_Your_Commenet:"Entrez votre commentaire",Reviews_Submit:"Soumettre",Notification_Paregraph_1:"Guidance sur la personnalisation du contenu des notifications, y compris le message, l'objet et les informations suppl\xe9mentaires.",Notification_date_1:"09 min",Notification_Paregraph_2:"Clarification sur les limites \xe9ventuelles concernant le nombre de notifications pouvant \xeatre envoy\xe9es, \xe9ventuellement en fonction des abonnements ou des restrictions du fournisseur de services.",Notification_date_2:"11 min Nov",Notification_Paregraph_3:"Explication de la programmation des notifications pour les envoyer \xe0 des moments et des dates sp\xe9cifiques.",Notification_date_3:"23 Nov, Lun",Notification_Paregraph_4:"D\xe9tails sur la configuration de rappels automatiques pour les r\xe9pondants n'ayant pas termin\xe9 le sondage dans un d\xe9lai d\xe9fini.",Notification_date_4:"56 min",Notification_Paregraph_5:"Informations sur le suivi du statut de livraison des notifications pour garantir une transmission r\xe9ussie.",Notification_date_5:"22 min",Notification_Paregraph_6:"Instructions pour g\xe9rer les pr\xe9f\xe9rences de notification des r\xe9pondants, telles que l'inscription ou la d\xe9sinscription \xe0 la r\xe9ception de notifications.",Notification_date_6:"40 min",Notification_Paregraph_7:"Explication de la personnalisation des notifications en fonction des actions des r\xe9pondants, comme la fin du sondage ou la fourniture de r\xe9ponses sp\xe9cifiques.",Notification_date_7:"18 d\xe9c, Sam",Notification_Paregraph_8:"Guidance sur la r\xe9ception de notifications pour de nouvelles r\xe9ponses au sondage en temps r\xe9el ou \xe0 intervalles programm\xe9s.",Notification_date_8:"01 ao\xfbt, Dim",Notification_Paregraph_9:"Options pour configurer les heures de silence ou sp\xe9cifier les moments o\xf9 les notifications ne doivent pas \xeatre envoy\xe9es.",Notification_date_9:"22 d\xe9c, Mar",Notification_Text:"Notification",Help_Text:"Aide",FAQ_Text:"FAQ",Reviews_Screen:"Avis",Name_Label:"Nom",Enter_Email:"Entrez votre adresse e-mail",Submitbutton:"Soumettre",Email_Successfull:"L'email a \xe9t\xe9 envoy\xe9 avec succ\xe8s",Setting_Title_1:"Bluetooth",Setting_Title_2:"Appuyez sur Pr\xe9f\xe9rences de connexion des appareils connect\xe9s.",Setting_Title_3:"Notification",Setting_Title_4:"Afficher l'utilisation des donn\xe9es de la carte SIM via le r\xe9seau de donn\xe9es actuel",Setting_Title_5:"Sauvegarde dans le cloud",Setting_Title_6:"Modifier mon plan d'achat de stockage cloud",Setting_Title_7:"Mode sombre",Setting_Title_8:"Comptes et sauvegarde",Setting_Title_9:"Apr\xe8s la r\xe9installation d'une application, le syst\xe8me la restaurera.",Setting_Title_10:"S\xe9lectionnez votre langue",Setting_Title_11:"Fonctionnalit\xe9s avanc\xe9es",Setting_Title_12:"Autoriser le service de localisation et d'autres applications.",Setting_Title_13:"\xc0 propos du t\xe9l\xe9phone",Setting_Title_14:"Niveau de patch de s\xe9curit\xe9 Android",Audio_Call_Title_1:"Astrotalk",Audio_Call_Title_2:"Liam Livingstone",Audio_Call_Title_3:"Muet",Audio_Call_Title_4:"Message",Audio_Call_Title_5:"Haut-parleur",Audio_Call_Title_6:"\xc0 propos",Matching_Title_3:"Modifier l'emplacement",Search_Text:"Rechercher",Matching_Title_4:"Emplacement actuel",Matching_Title_5:"En utilisant le GPS",Matching_Title_6:"Star Plaza 106-108 Pr\xe8s de Sunshine Road",Matching_Title_7:"Star Plaza",Matching_Title_8:"travail",Matching_Title_9:"Star Plaza 106-108 Pr\xe8s de Sunshine Road",Matching_Title_10:"Emplacement",Matching_Title_11:"54 Sargood Drive, Wanaka",Matching_Title_12:"Confirmer",Category_Listing_37:"Accueil",Category_Listing_38:"QXV+FMG, Phulchhab Bhavan, MG Rd, Phulchhab Chowk, Rajkot",Category_Listing_39:"Confirmer l'emplacement",Category_Listing_40:"Rechercher l'emplacement",Category_Listing_41:"Emplacement actuel",Category_Listing_42:"Gare ferroviaire, Sorath Plaza 101 \xe0 105",Category_Listing_43:"Accueil",Category_Listing_44:"Bhakti Nagar Station, Plot, Tagore Rd",Category_Listing_45:"Bureau",Category_Listing_46:"Magasin n\xb0 1, ARIHANT, Tagore Rd, Virani Chowk",Home_Title_1:"  Excellent",Home_Title_2:"  Bien",Home_Title_3:"  Pas Bien",Home_Title_4:"Spectre de sondage",Home_Title_5:"Plateforme de pulsations perspicaces",Home_Title_6:"Sondage d'enqu\xeate pers